rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation helpers
    function isValidProject(data) {
      return data.userId is string &&
             data.subject is string && data.subject.size() <= 1000 &&
             data.title is string && data.title.size() <= 200 &&
             data.createdAt is timestamp;
    }
    
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 256 &&
             data.createdAt is timestamp;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == existing().createdAt;
      
      // Projects
      match /projects/{projectId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming()) && incoming().userId == userId && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidProject(incoming()) && incoming().userId == userId && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'projectData']);
        allow delete: if isOwner(userId);
      }
    }
  }
}

{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "project": {
      "title": "Generated Project",
      "description": "Saved video generation project",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 1024 },
        "modeName": { "type": "string", "maxLength": 128 },
        "modeNumber": { "type": "number" },
        "scenesCount": { "type": "number" },
        "durationPerScene": { "type": "number" },
        "aspectRatio": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "subject", "modeName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "project",
      "description": "User's generated video projects sub-collection"
    }
  }
}

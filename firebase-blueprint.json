{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A generated project.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user who created the project." },
        "subject": { "type": "string", "description": "The subject of the project." },
        "title": { "type": "string", "description": "The title of the project." },
        "modeName": { "type": "string", "description": "The mode used." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The creation time." },
        "projectData": { "type": "object", "description": "The generated project data." }
      },
      "required": ["userId", "subject", "title", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user profile.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "The user email." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The creation time." }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "Project" }, 
      "description": "User profile document."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "Project" },
      "description": "Projects belonging to a user."
    }
  }
}
